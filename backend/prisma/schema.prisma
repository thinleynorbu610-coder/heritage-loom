generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum UserRole {
  customer
  admin
}

enum UserStatus {
  active
  locked
  disabled
}

enum AuthTokenType {
  email_verification
  password_reset
}

model User {
  id                String         @id @default(auto()) @map("_id") @db.ObjectId
  email             String
  normalizedEmail   String         @unique
  passwordHash      String
  name              String
  role              UserRole       @default(customer)
  status            UserStatus     @default(active)
  failedLoginCount  Int            @default(0)
  lockedUntil       DateTime?
  emailVerifiedAt   DateTime?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  refreshTokens     RefreshToken[]
  authTokens        AuthToken[]
  addresses         Address[]
  @@index([status])
}

model Address {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  userId         String   @db.ObjectId
  recipientName  String
  line1          String
  line2          String?
  city           String
  region         String?
  postalCode     String
  country        String   @default("BT")
  phone          String?
  isDefault      Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
}

model Category {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  slug        String    @unique
  description String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  products    Product[]
  @@index([isActive])
}

model Product {
  id              String    @id @default(auto()) @map("_id") @db.ObjectId
  categoryId      String    @db.ObjectId
  name            String
  slug            String    @unique
  description     String
  priceMinor      Int
  currency        String    @default("BTN")
  imageUrls       String[]
  inventoryCount  Int       @default(0)
  isActive        Boolean   @default(true)
  deletedAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  category        Category  @relation(fields: [categoryId], references: [id])
  @@index([categoryId, isActive])
  @@index([priceMinor])
  @@index([createdAt])
}

model RefreshToken {
  id                String   @id @default(auto()) @map("_id") @db.ObjectId
  userId            String   @db.ObjectId
  familyId          String   @db.ObjectId
  tokenHash         String   @unique
  expiresAt         DateTime
  revokedAt         DateTime?
  replacedByTokenId String?  @db.ObjectId
  createdAt         DateTime @default(now())
  lastUsedAt        DateTime?
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, familyId])
  @@index([expiresAt])
}

model AuthToken {
  id          String        @id @default(auto()) @map("_id") @db.ObjectId
  userId      String        @db.ObjectId
  tokenHash   String        @unique
  type        AuthTokenType
  expiresAt   DateTime
  consumedAt  DateTime?
  createdAt   DateTime      @default(now())
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, type])
  @@index([expiresAt])
}
