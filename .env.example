# Supabase project settings — from your project's Settings → API page.
# Copy this file to .env.local (gitignored) and fill in real values for local dev.
# The same three values also need to be set on Render (Dashboard → Environment).

# Project URL, e.g. https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# anon / public key — safe to expose to the browser, enforced by Row Level Security.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# service_role key — SECRET. Server-side code only (Route Handlers, server components,
# scripts). Never import this in a "use client" file or prefix it with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
